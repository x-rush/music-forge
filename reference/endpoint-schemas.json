{
  "$comment": "请求体 schema 存档。来源：官方文档 docs.acedata.cloud/zh-Hans/guides/suno/suno_audios（2026-10-13 逐字段核对）+ reference/endpoints.md 实测记录。acedata 无机器可读 OpenAPI，此文件即 --advanced-json 的权威键名清单——字段变动先改这里再改 CLI。",
  "acedata-suno-generate": {
    "path": "POST https://api.acedata.cloud/suno/audios (action=generate)",
    "properties": {
      "custom": { "type": "boolean", "desc": "自定义模式开关（与 prompt 二选一）" },
      "lyric": { "type": "string", "desc": "custom=true 时必带；≤5000 字符（v4.5+）/ ≤3000（v4-）" },
      "prompt": { "type": "string", "desc": "灵感模式描述，≤500 字符" },
      "title": { "type": "string", "desc": "≤100（v4.5+）/ ≤80（旧）" },
      "style": { "type": "string", "desc": "风格标签 ≤1000（v4.5+）/ ≤200（旧）" },
      "instrumental": { "type": "boolean", "desc": "纯音乐" },
      "negative_tags": { "type": "string", "desc": "反向风格标签" },
      "vocal_gender": { "enum": ["f", "m"], "desc": "人声性别（v4.5+）" },
      "duration": { "type": "number", "desc": "10-360 整数，倾向值非硬约束" },
      "weirdness": { "type": "number", "desc": "0-1，越大越实验性" },
      "style_influence": { "type": "number", "desc": "0-1，越大越贴风格标签" },
      "audio_weight": { "type": "number", "desc": "0-1 音频权重（0 为有效值）；官方文档 2026-10-13 核对补录" },
      "lyric_prompt": { "type": "string", "desc": "当且仅当 custom=true 且未传 lyric 时生效；官方文档 2026-10-13 核对补录" },
      "callback_url": { "type": "string", "desc": "回调地址（与 async 轮询二选一）；官方文档 2026-10-13 核对补录" },
      "variety": { "enum": ["off", "normal", "high", "extra", "max"], "desc": "多样性档；仅 generate 与 add_stem 接受，其他 action 返回 400" },
      "max_mode": { "type": "boolean", "desc": "增强档（需 custom=true），计费 1.12 credits" }
    },
    "required": [],
    "provider_added": { "action": "generate", "model": "chirp-v6 系枚举见 models.json", "async": "true（2026-10-10 起统一异步）" }
  },
  "useapi-mureka-create": {
    "path": "POST https://api.useapi.net/v1/mureka/music/create",
    "properties": {
      "prompt": { "type": "string", "desc": "灵感描述（与 lyrics 二选一）" },
      "lyrics": { "type": "string", "desc": "自定义歌词" },
      "title": { "type": "string" },
      "instrumental": { "type": "boolean", "desc": "provider 据此路由 create-instrumental" },
      "model": { "type": "string", "desc": "mureka 模型枚举" }
    },
    "required": []
  }
}
